# Copy to .env and set per environment.
# Port the Tripwise API listens on. The Tripwise web app's VITE_API_URL points here.
PORT=3001
# Origin of the Tripwise web app, allowed by CORS.
CORS_ORIGIN=http://localhost:5173
# Key for the Anthropic API, which the Tripwise Assistant's replies come from (POST /api/assistant/chat).
ANTHROPIC_API_KEY=
# Pendo Track Events key, used to send the Tripwise Assistant's prompts and replies to Pendo Agent Analytics.
# Leave empty to turn tracking off.
PENDO_TRACK_EVENT_SECRET=
# Pendo Track Events endpoint for your Pendo region (defaults to https://app.pendo.io/data/track).
PENDO_TRACK_EVENT_URL=
