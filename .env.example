# Copy to .env and set per environment.
# Port the Tripwise API listens on. The Tripwise web app's VITE_API_URL points here.
PORT=3001
# Origin of the Tripwise web app, allowed by CORS.
CORS_ORIGIN=http://localhost:5173
# Key for the Anthropic API, which the Tripwise Assistant's replies come from (POST /api/assistant/chat).
ANTHROPIC_API_KEY=
# Track Event Shared Secret from the Tripwise app's settings in Pendo, for sending the Tripwise Assistant's prompts
# and replies to Pendo as trackAgent events. Leave it empty to send nothing.
PENDO_TRACK_EVENT_SECRET=
# Pendo's Track Events endpoint for the subscription's region, such as https://app.eu.pendo.io/data/track in the EU.
PENDO_TRACK_URL=https://app.pendo.io/data/track
