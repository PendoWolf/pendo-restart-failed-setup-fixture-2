# Copy to .env and set per environment.
# Port the Tripwise API listens on. The Tripwise web app's VITE_API_URL points here.
PORT=3001
# Origin of the Tripwise web app, allowed by CORS.
CORS_ORIGIN=http://localhost:5173
# Key for the Anthropic API, which the Tripwise Assistant's replies come from (POST /api/assistant/chat).
ANTHROPIC_API_KEY=
# Pendo Track Events integration key (server-side secret). The Tripwise Assistant's prompts and replies are
# sent to Pendo as agent events while it's set; leave it empty to turn that off.
PENDO_TRACK_EVENT_SECRET=
# Pendo Track Events endpoint. Change it for a Pendo data center other than the US one.
PENDO_TRACK_URL=https://app.pendo.io/data/track
