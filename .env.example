# Copy to .env and set per environment.
# Port the Tripwise API listens on. The Tripwise web app's VITE_API_URL points here.
PORT=3001
# Origin of the Tripwise web app, allowed by CORS.
CORS_ORIGIN=http://localhost:5173
# Key for the Anthropic API, which the Tripwise Assistant's replies come from (POST /api/assistant/chat).
ANTHROPIC_API_KEY=
# Pendo track event shared secret. When set, the Tripwise Assistant's prompts and replies are sent to Pendo
# Agent Analytics as server-side track events; when empty, nothing is sent.
PENDO_TRACK_EVENT_SECRET=
# Pendo's track event endpoint. Change it for a non-US Pendo data center (such as https://app.eu.pendo.io/data/track).
PENDO_TRACK_URL=https://app.pendo.io/data/track
