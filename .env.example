# Copy to .env and set per environment.
# Port the Tripwise API listens on. The Tripwise web app's VITE_API_URL points here.
PORT=3001
# Origin of the Tripwise web app, allowed by CORS.
CORS_ORIGIN=http://localhost:5173
# Key for the Anthropic API, which the Tripwise Assistant's replies come from (POST /api/assistant/chat).
ANTHROPIC_API_KEY=
# Pendo integration key for the server-side Track Events API. The Tripwise Assistant's trackAgent events
# (prompt, agent_response) are sent with it; leave empty to send none. Keep the real key out of version control.
PENDO_INTEGRATION_KEY=
# Pendo data host for your region, such as https://app.eu.pendo.io. Defaults to https://app.pendo.io.
PENDO_DATA_HOST=
